# Browser-safe InsForge client configuration
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Leave unset in production to send browser API calls through the same-origin
# Next.js rewrite. BACKEND_URL is server-side and should point to the Modal URL.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK_API=false
