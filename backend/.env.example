# ============================================================
# Rebutio Environment Configuration
# ============================================================

# Database (PostgreSQL for production, SQLite async for local dev)
DATABASE_URL=sqlite+aiosqlite:///./rebutio.db

# Security & Application-level AES-256-GCM encryption key (32 bytes hex or base64)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REBUTIO_DATA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REBUTIO_SESSION_SECRET=rebutio-dev-session-secret-change-in-production

# InsForge backend and JWT verification. Retrieve JWT_PUBLIC_KEY with:
# npx -y @insforge/cli secrets get JWT_PUBLIC_KEY
INSFORGE_URL=https://your-project.region.insforge.app
INSFORGE_API_KEY=
INSFORGE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Observability & Structured Logging
LOG_LEVEL=INFO
LOG_FORMAT=console          # 'console' for local development, 'json' for production
LOG_AI_CONTENT=false        # Development-only debug flag. NEVER enable in production.
DB_SLOW_QUERY_MS=500        # Threshold in milliseconds to log slow database queries

# AI Gateways
OPENROUTER_API_KEY=
RAMP_ROUTER_API_KEY=

# OpenRouter Role Models (defaults)
OPENROUTER_TRANSCRIPTION_MODEL=microsoft/mai-transcribe-1.5
OPENROUTER_DEBATE_MODEL=openai/gpt-5.6-luna:nitro
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_ANALYSIS_MODEL=openai/gpt-5.6-luna:nitro
OPENROUTER_FINAL_PATCH_MODEL=openai/gpt-5.6-luna:nitro
OPENROUTER_REVIEW_MODEL=openai/gpt-5.6-luna:nitro
OPENROUTER_TOPIC_MODEL=openai/gpt-5.6-luna:nitro
OPENROUTER_COACH_MODEL=openai/gpt-5.6-luna:nitro

# Router.com / Ramp Router Models (primary active per role)
ROUTER_DEBATE_MODEL=gpt-5.6-luna
ROUTER_ANALYSIS_MODEL=gpt-5.6-luna
ROUTER_REVIEW_MODEL=gpt-5.6-luna
ROUTER_TOPIC_MODEL=gpt-5.6-luna
ROUTER_COACH_MODEL=gpt-5.6-luna

# TTS Voice configuration (optional, model-dependent)
REBUTIO_TTS_VOICE=af_bella

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:3000

# Modal App configuration (Speech analysis on remote Modal CPU worker)
MODAL_APP_NAME=rebutio-speech-analysis

# Retention and Privacy
EVIDENCE_RETENTION_HOURS=24
SAVE_TRANSCRIPTS_DEFAULT=false

# Server binding
HOST=0.0.0.0
PORT=8000
